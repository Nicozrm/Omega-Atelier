# OMEGA Atelier 2.0 -- nginx-Konfiguration (SPA + PWA)
# ${PORT} wird beim Containerstart durch envsubst ersetzt.

map $uri $omega_cache_control {
      # Default ist bewusst "no-cache": alles, was nicht unten steht, ist
      # entweder der App-Shell (index.html), der Service Worker oder das
      # Manifest. Die revalidieren per ETag - ein 304 kostet nichts, eine
      # veraltete Shell dagegen einen kaputten Deploy.
      default                                     "no-cache";

      # Vite-Build-Artefakte tragen einen Content-Hash im Namen.
      ~^/assets/                                  "public, max-age=31536000, immutable";

      # Grosse statische Medien: eine Woche.
      ~^/(models|textures|draco)/                 "public, max-age=604800";

      # Icons, Promo-Video, Fonts im Root: ein Tag.
      ~\.(png|jpe?g|svg|webp|avif|mp4|webm|woff2?|ico)$  "public, max-age=86400";
}

server {
      # Nur IPv4: nicht jeder Container-Host hat einen IPv6-Stack, und ein
      # "listen [::]" laesst nginx dort mit "Address family not supported"
      # gar nicht erst starten. Das Hyperlift-Ingress spricht IPv4.
      listen       ${PORT};
        server_name  _;

      root  /usr/share/nginx/html;
      index index.html;

      absolute_redirect off;
      server_tokens     off;
      charset           utf-8;

      client_max_body_size 25m;

      # Header entsprechen der bisherigen vercel.json.
      add_header X-Content-Type-Options   "nosniff"                              always;
      add_header Referrer-Policy          "strict-origin-when-cross-origin"      always;
      add_header X-Frame-Options          "DENY"                                 always;
      add_header Permissions-Policy       "geolocation=(self), camera=(self), microphone=(self), payment=(self), interest-cohort=()" always;
      add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
      add_header Cache-Control            $omega_cache_control                   always;

      gzip              on;
      gzip_vary         on;
      gzip_comp_level   6;
      gzip_min_length   1024;
      gzip_proxied      any;
      gzip_types        text/plain text/css application/javascript application/json
                          application/manifest+json image/svg+xml model/gltf+json
                          application/wasm;

      # Liveness-Endpunkt fuer Hyperlift / HEALTHCHECK.
      location = /healthz {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
  }

      # Gehashte Build-Artefakte: existieren sie nicht, ist es ein echter 404 --
      # kein SPA-Fallback, sonst bekommt der Browser HTML statt JS.
      location /assets/ {
            try_files $uri =404;
  }

      # SPA-Fallback fuer alle Client-Routen.
      location / {
            try_files $uri $uri/ /index.html;
  }
}
