# OMEGA Atelier 2.0 — Environment template.
# Kopiere diese Datei zu `.env.local` und fülle die Werte aus deinem Supabase-Projekt.
# .env.local ist in .gitignore und landet niemals im Repo.

# Supabase Dashboard → Project Settings → API
# "Project URL"
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# "anon public" key — NIEMALS den service_role-Key hier reinpacken (der bypasst RLS!)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: separate URL für die Realtime-Verbindung (Default = abgeleitet aus VITE_SUPABASE_URL)
# VITE_SUPABASE_REALTIME_URL=

# Wenn beide Werte fehlen läuft die App im Local-Only-Modus (kein Cloud-Save, kein Login).
