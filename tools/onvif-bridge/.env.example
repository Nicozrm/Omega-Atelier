OMEGA_ONVIF_BRIDGE_HOST=127.0.0.1
OMEGA_ONVIF_BRIDGE_PORT=8787
OMEGA_ONVIF_BRIDGE_TOKEN=change-this
OMEGA_ONVIF_BRIDGE_ORIGIN=*

# Live picture ─────────────────────────────────────────────────────────────
# WebRTC is preferred. Point this at a LOCAL WHEP endpoint (go2rtc, MediaMTX);
# `{id}` is replaced with the camera id. Leave empty to use MJPEG instead.
# OMEGA_ONVIF_WEBRTC_WHEP=http://127.0.0.1:1984/api/webrtc?src={id}

# MJPEG fallback (needs ffmpeg on PATH).
# OMEGA_ONVIF_FFMPEG=ffmpeg
# OMEGA_ONVIF_MJPEG_FPS=12
# OMEGA_ONVIF_MJPEG_QUALITY=6

# PTZ ──────────────────────────────────────────────────────────────────────
# A zero-velocity ContinuousMove probe runs once after connect to find out
# whether PTZ works at all (capability discovery lies on some cameras).
# Set to 0 to skip it.
# OMEGA_ONVIF_PTZ_PROBE=1
